# Copy this file to `.env` and fill in your own values.
# Expo only exposes variables whose names start with EXPO_PUBLIC_.
# Never commit the real `.env` file.

# URL of your deployed Google Apps Script web app.
# It looks like: https://script.google.com/macros/s/XXXX/exec
EXPO_PUBLIC_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# The secret token your script checks. Use a long random string.
EXPO_PUBLIC_API_TOKEN=replace-with-your-token
